{
  "name": "komainu-guard",
  "version": "1.2.1",
  "description": "Security-First Legacy Modernization Platform CLI (LSA Kit, IAM Perimeter, Cross-User Testing)",
  "main": "remediate/authz/nodejs/src/index.js",
  "types": "remediate/authz/nodejs/src/index.d.ts",
  "bin": {
    "komainu": "bin/komainu.js",
    "komainu-guard": "bin/komainu.js"
  },
  "files": [
    "bin/",
    "assess/",
    "operate/",
    "remediate/",
    "contracts/",
    "governance/",
    "examples/",
    "README.md",
    "CHANGELOG.md",
    "!**/__pycache__/**",
    "!**/.gradle/**",
    "!**/build/**",
    "!**/bin/Debug/**",
    "!**/bin/Release/**",
    "!**/obj/**",
    "!**/.kotlin/**",
    "!**/*.pyc",
    "!**/*.db",
    "!**/*.sqlite"

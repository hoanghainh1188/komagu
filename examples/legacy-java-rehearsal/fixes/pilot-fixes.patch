diff -ruN a/src/main/java/com/example/ams/web/Ownership.java b/src/main/java/com/example/ams/web/Ownership.java
--- a/src/main/java/com/example/ams/web/Ownership.java	1970-01-01 08:00:00
+++ b/src/main/java/com/example/ams/web/Ownership.java	2026-11-11 00:11:28
@@ -0,0 +1,32 @@
+package com.example.ams.web;
+
+import com.example.ams.Db;
+import dev.komagu.legacy.shim.OwnershipEnforcer;
+import dev.komagu.legacy.shim.OwnershipEnforcer.TableOwnershipSchema;
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Map;
+import javax.servlet.http.HttpServletRequest;
+
+/** Ownership checks for the runbook W10-3 fixes. Identity comes only from the server-side session. */
+final class Ownership {
+    private static final Map<String, TableOwnershipSchema> TABLES;
+
+    static {
+        Map<String, TableOwnershipSchema> tables = new HashMap<>();
+        tables.put("orders", new TableOwnershipSchema("orders", "id", "owner_id"));
+        tables.put("invoices", new TableOwnershipSchema("invoices", "id", "owner_id"));
+        TABLES = Collections.unmodifiableMap(tables);
+    }
+
+    private Ownership() {
+    }
+
+    static long require(HttpServletRequest request, String table, String id) throws SQLException {
+        try (Connection conn = Db.open()) {
+            return OwnershipEnforcer.requireOwnership(conn, table, id, request.getSession().getAttribute("userId"), TABLES);
+        }
+    }
+}

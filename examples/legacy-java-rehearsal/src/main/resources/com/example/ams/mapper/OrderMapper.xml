<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.ams.mapper.OrderMapper">
  <select id="listMine" resultType="com.example.ams.model.Order">
    SELECT id, owner_id AS ownerId, item, note, total FROM orders
    WHERE owner_id = #{ownerId}
    ORDER BY ${sort}
  </select>
</mapper>

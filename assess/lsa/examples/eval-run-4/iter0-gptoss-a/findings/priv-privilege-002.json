  "findings": [
    {
      "finding_id": "MASS-M-0006-1",
      "category": "mass_assignment",
      "subtype": "whole_object_binding",
      "title": "Profile update binds the entire request body to the User model",
      "candidate_id": "M-0006",
      "endpoint": {
        "method": "PUT",
        "path": "/profile"
      },
      "attack_vector": {
        "method": "PUT",
        "path": "/profile",
        "fields": {
          "role": "admin"
        },
        "readback": "GET /profile"
      },
      "location": {
        "file": "routes/user.js",
        "start_line": 7,
        "end_line": 8
      },
      "evidence": [
        {
          "file": "routes/user.js",
          "line": 8,
          "code": "User.findByIdAndUpdate(req.user._id, req.body, function (e, u) { res.json(u); });",
          "why": "Whole request body is bound to the User model without an allowlist."
        }
      ],
      "attack_scenario": "A normal authenticated user can set the role field to \"admin\" and become an administrator.",
      "impact": [
        "role"
      ],
      "severity": "critical",
      "confidence": "high",
      "cwe": [
        "CWE-915"
      ],
      "owasp": [
        "API3:2023"
      ],
      "recommendation": "Only copy allowed fields from the request, e.g. { name: req.body.name, email: req.body.email }.",
      "fix_example": "User.findByIdAndUpdate(req.user._id, { name: req.body.name, email: req.body.email }, ...);",
      "status": "unverified"
    },

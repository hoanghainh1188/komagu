      "candidate_id": "M-0009",
      "endpoint": {
        "method": "POST",
        "path": "/team"
      },
      "attack_vector": {
        "method": "POST",
        "path": "/team",
        "fields": {
          "owner_id": 999
        },
        "readback": "GET /teams/<id>"
      },
      "location": {
        "file": "app/Http/Controllers/AccountController.php",
        "start_line": 21,
        "end_line": 23
      },
      "evidence": [
        {
          "file": "app/Http/Controllers/AccountController.php",
          "line": 23,
          "code": "return Team::create($request->all());",
          "why": "Whole request body is bound to the Team model; owner_id is a privileged field."
        }
      ],
      "attack_scenario": "A user can create a team and set the owner_id to any user, effectively transferring ownership.",
      "impact": [
        "owner_id"
      ],
      "severity": "critical",
      "confidence": "high",
      "cwe": [
        "CWE-915",
        "CWE-269"
      ],
      "owasp": [
        "API3:2023"
      ],
      "recommendation": "Exclude owner_id from the bind or set it server\u2011side to the current user.",
      "fix_example": "return Team::create($request->only(['name', 'description']));",
      "status": "unverified"
    },

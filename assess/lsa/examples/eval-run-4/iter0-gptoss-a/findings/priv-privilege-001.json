    {
      "finding_id": "BFLA-0009-1",
      "category": "bfla",
      "subtype": "role_from_request",
      "title": "ASP.NET MVC Export action trusts request query for admin access",
      "route_id": "R-0009",
      "endpoint": {
        "method": "GET",
        "path": "/Admin/Export"
      },
      "location": {
        "file": "Web/Controllers/AdminController.cs",
        "start_line": 30,
        "end_line": 37
      },
      "evidence": [
        {
          "file": "Web/Controllers/AdminController.cs",
          "line": 32,
          "code": "if (Request.QueryString[\"isAdmin\"] == \"true\") { \u2026 }",
          "why": "role derived from client request"
        }
      ],
      "attack_scenario": "A logged\u2011in user can set ?isAdmin=true to export all users.",
      "impact": "Unauthorized data export of all user records.",
      "severity": "critical",
      "confidence": "high",
      "cwe": [
        "CWE-269",
        "CWE-285"
      ],
      "owasp": [
        "API5:2023"
      ],
      "recommendation": "Remove reliance on client query and enforce server\u2011side role check.",
      "fix_example": "if (!User.IsInRole(\"Admin\")) { return new HttpStatusCodeResult(403); }",
      "status": "unverified"
    },
    {

{
  "batch_id": "privilege-001",
  "findings": [
    {
      "finding_id": "BFLA-0003-1",
      "category": "bfla",
      "subtype": "missing_role_check",
      "title": "Classic\u2011ASP member deletion without role check",
      "route_id": "R-0003",
      "endpoint": {
        "method": "GET|POST",
        "path": "/classic-asp/shop/member.asp?mode=delete"
      },
      "location": {
        "file": "classic-asp/shop/member.asp",
        "start_line": 1,
        "end_line": 11
      },
      "evidence": [
        {
          "file": "classic-asp/shop/member.asp",
          "line": 1,
          "code": "<!--#include file=\"inc/auth.asp\"-->",
          "why": "auth guard only checks session, no role"
        },
        {
          "file": "classic-asp/shop/member.asp",
          "line": 10,
          "code": "conn.Execute \"DELETE FROM members WHERE member_id = \" & Request.QueryString(\"member_id\")",
          "why": "privileged action, no role check"
        }
      ],
      "attack_scenario": "A logged\u2011in user can delete any member by supplying a member_id in the query string.",
      "impact": "Any authenticated user can delete arbitrary members, including administrators.",
      "severity": "critical",
      "confidence": "high",
      "cwe": [
        "CWE-285"
      ],
      "owasp": [
        "API5:2023"
      ],
      "recommendation": "Add a server\u2011side role check that ensures the current user has the 'Admin' role before executing the delete.",
      "fix_example": "If Not CheckRole(\"Admin\") Then Response.Status = \"403 Forbidden\" : Response.End",
      "status": "unverified"
    },
    {

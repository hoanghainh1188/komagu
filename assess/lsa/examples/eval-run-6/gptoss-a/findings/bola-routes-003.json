      "finding_id": "BOLA-R-0033",
      "category": "bola",
      "subtype": "missing_ownership_check",
      "title": "BOLA in GET /orders/:id: missing owner verification",
      "route_id": "R-0033",
      "endpoint": {
        "method": "GET",
        "path": "/orders/:id"
      },
      "location": {
        "file": "node-express/routes/orders.js",
        "start_line": 8
      },
      "evidence": [
        {
          "file": "node-express/routes/orders.js",
          "start_line": 8,
          "code": "Order.findById(req.params.id, function (err, order) { res.json(order); });",
          "why": "The order ID comes from the request and is used without checking that the order belongs to the authenticated user.",
          "line": 8
        }
      ],
      "severity": "high",
      "confidence": "high",
      "cwe": [
        "CWE-639",
        "CWE-284"
      ],
      "recommendation": "Add an ownership check by filtering on the authenticated user\u2019s ID or by loading the order and verifying its owner before returning it.",
      "status": "unverified",
      "attack_vector": {
        "target_param": "id"
      }
    },

      "finding_id": "BFLA-R-0003-1",
      "category": "bfla",
      "subtype": "missing_role_check",
      "title": "Unrestricted member deletion in classic\u2011asp shop",
      "route_id": "R-0003",
      "location": {
        "file": "classic-asp/shop/member.asp",
        "start_line": 10
      },
      "evidence": [
        {
          "file": "classic-asp/shop/member.asp",
          "line": 10,
          "why": "DELETE statement executed without any role check"
        }
      ],
      "impact": "Any logged\u2011in user can delete any member record",
      "severity": "critical",
      "confidence": "high",
      "cwe": [
        "CWE-285"
      ],
      "recommendation": "Add a server\u2011side admin role check before executing the DELETE",
      "status": "unverified"
    },

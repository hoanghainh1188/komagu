      "subtype": "missing_ownership_check",
      "title": "BOLA in GET/POST /user/edit.do: missing owner verification",
      "route_id": "R-0001",
      "endpoint": {
        "method": "ANY",
        "path": "/user/edit.do"
      },
      "location": {
        "file": "java-legacy/src/com/acme/struts/EditUserAction.java",
        "start_line": 10
      },
      "evidence": [
        {
          "file": "java-legacy/src/com/acme/struts/EditUserAction.java",
          "start_line": 10,
          "code": "String userId = request.getParameter(\"user_id\");",
          "why": "ID comes from the request, not from the session.",
          "line": 10
        },
        {
          "file": "java-legacy/src/com/acme/struts/EditUserAction.java",
          "start_line": 13,
          "code": "PreparedStatement ps = conn.prepareStatement(\"UPDATE users SET email = '\" + email + \"' WHERE id = \" + userId);",
          "why": "No check that the userId belongs to the current user.",
          "line": 13
        }
      ],
      "severity": "high",
      "confidence": "high",
      "cwe": [
        "CWE-284",
        "CWE-639"
      ],
      "recommendation": "Verify that the userId matches the authenticated user before performing the update.",
      "status": "unverified",
      "attack_vector": {
        "target_param": "user_id"
      }
    },

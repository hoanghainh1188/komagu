      "finding_id": "BOLA-R-0033",
      "category": "bola",
      "subtype": "missing_ownership_check",
      "title": "BOLA in GET /orders/:id: missing owner verification",
      "route_id": "R-0033",
      "endpoint": {
        "method": "GET",
        "path": "/orders/:id"
      },
      "location": {
        "file": "node-express/routes/orders.js",
        "start_line": 8
      },
      "evidence": [
        {
          "file": "node-express/routes/orders.js",
          "start_line": 8,
          "code": "Order.findById(req.params.id, function (err, order) { res.json(order); });",
          "why": "The query retrieves an order solely by its id, with no filter on the current user.",
          "line": 8
        }
      ],
      "severity": "high",
      "confidence": "high",
      "cwe": [
        "CWE-284",
        "CWE-639"
      ],
      "recommendation": "Add a check that the order belongs to the authenticated user before returning it, e.g., by filtering on user_id or comparing the owner after retrieval.",
      "status": "unverified",
      "attack_vector": {
        "target_param": "id"
      }
    },

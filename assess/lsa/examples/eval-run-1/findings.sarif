          "rules": [
            {
              "id": "lsa/bola/id_from_request_used_as_identity",
              "name": "bola.id_from_request_used_as_identity",
              "shortDescription": {
                "text": "Broken object level authorization (BOLA/IDOR) — id from request used as identity"
              },
              "fullDescription": {
                "text": "The endpoint accesses an object selected by a request-controlled identifier without binding the access to the current user or tenant."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-639",
                  "CWE-566",
                  "API1:2023"
                ],
                "security-severity": "9.5"
              }
            },

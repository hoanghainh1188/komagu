          "rules": [
            {
              "id": "lsa/bola/missing_role_check",
              "name": "bola.missing_role_check",
              "shortDescription": {
                "text": "Broken object level authorization (BOLA/IDOR) — missing role check"
              },
              "fullDescription": {
                "text": "The endpoint accesses an object selected by a request-controlled identifier without binding the access to the current user or tenant."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-285",
                  "CWE-639",
                  "API5:2023",
                  "API1:2023"
                ],

          "level": "error",
          "message": {
            "text": "Any logged-in user can delete arbitrary user accounts via admin.php?action=delete [POST /admin.php?action=delete] — Verify that the current session belongs to an authorized administrator before allowing user deletion, and use a prepared statement bound to the validated user ID."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "admin.php",
                  "uriBaseId": "SRCROOT"

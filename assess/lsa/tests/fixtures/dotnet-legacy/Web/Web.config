<?xml version="1.0"?>
<configuration>
  <system.web>
    <authentication mode="Forms"><forms loginUrl="~/Login.aspx" /></authentication>
    <authorization><deny users="?" /></authorization>
  </system.web>
  <location path="Handlers">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
</configuration>

#!/bin/sh
# Block direct pushes to main. Work goes through a branch and a pull request
# (see CLAUDE.md, "Working with issues"). GitHub Free cannot enforce this on a
# private repository, so this local hook is the guard.
# Enable once per clone: git config core.hooksPath .githooks
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct push to main is blocked. Push a branch and open a pull request." >&2
    exit 1
  fi
done
exit 0

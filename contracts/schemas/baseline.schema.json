{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lsa/baseline.schema.json",
  "title": "Komagu scan baseline",
  "type": "object",
  "required": [
    "version",
    "entries"
  ],
  "properties": {
    "version": {
      "enum": [
        1
      ]
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fingerprint",
          "first_seen",
          "last_seen",
          "state",
          "fixed_at"
        ],
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^kfp1:[0-9a-f]{64}$"
          },
          "first_seen": {
            "type": [
              "string",
              "null"
            ],
            "description": "null when imported from a SARIF file without history"
          },
          "last_seen": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "enum": [
              "open",
              "fixed"
            ]
          },
          "fixed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "category": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "description": "file of the finding; in diff mode only entries in scanned files can become fixed"
          }
        }
      }
    },
    "history": {
      "type": "array",
      "description": "one snapshot per full scan day (diff scans add none); newest last, capped at 365",
      "items": {
        "type": "object",
        "required": [
          "date",
          "open"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "open": {
            "type": "integer",
            "minimum": 0
          },
          "new": {
            "type": "integer",
            "minimum": 0
          },
          "regressed": {
            "type": "integer",
            "minimum": 0
          },
          "fixed": {
            "type": "integer",
            "minimum": 0
          },
          "suppressed": {
            "type": "integer",
            "minimum": 0
          },
          "by_severity": {
            "type": "object",
            "properties": {
              "critical": {
                "type": "integer",
                "minimum": 0
              },
              "high": {
                "type": "integer",
                "minimum": 0
              },
              "medium": {
                "type": "integer",
                "minimum": 0
              },
              "low": {
                "type": "integer",
                "minimum": 0
              },
              "info": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operate/persona-suite.schema.json",
  "title": "Komagu test suite v2 (persona matrix)",
  "description": "Personas and, per route, the personas allowed to call it. Every other persona must be refused (BFLA). Tokens come only from environment variables; session cookies come from an environment variable or a file.",
  "type": "object",
  "required": [
    "version",
    "personas",
    "routes"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 2
    },
    "personas": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token_env": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "description": "Environment variable that holds this persona's bearer token. Omit for an anonymous persona."
          },
          "cookie_env": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "description": "Environment variable that holds this persona's Cookie value, e.g. JSESSIONID=... Use for session-based apps instead of token_env."
          },
          "cookie_file": {
            "type": "string",
            "description": "Path to a file that holds this persona's Cookie value."
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "allow"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "method": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ],
            "default": "GET"
          },
          "path": {
            "type": "string",
            "pattern": "^/",
            "description": "Path with {name} or :name placeholders, filled from params or --resource-id."
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "payload": {
            "type": "object",
            "description": "Body fields for writes, encoded as set by body_format."
          },
          "allow": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Personas allowed to call the route. Every other persona must get 401/403/404 (404 only with --strict)."
          },
          "mass_assignment_probe": {
            "type": "object",
            "required": [
              "fields"
            ],
            "additionalProperties": false,
            "properties": {
              "fields": {
                "type": "object",
                "minProperties": 1,
                "description": "Privileged fields and values added to the payload. Use values the object does not already have."
              },
              "persona": {
                "type": "string",
                "description": "Persona that sends the write (default: first persona in allow)."
              },
              "readback": {
                "type": "string",
                "pattern": "^((GET|POST|PUT|PATCH|DELETE) )?/",
                "description": "Request that returns the stored object, e.g. 'GET /api/profile' (default: GET on the route path)."
              }
            }
          },
          "body_format": {
            "enum": [
              "json",
              "form"
            ],
            "default": "json",
            "description": "Body encoding. form sends application/x-www-form-urlencoded."
          },
          "csrf": {
            "type": "object",
            "required": [
              "page",
              "field"
            ],
            "additionalProperties": false,
            "description": "Fetch this page before each write and send the token found in the named field.",
            "properties": {
              "page": {
                "type": "string",
                "pattern": "^/"
              },
              "field": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
